# Local ChartSearchAI configuration
#
# `make chartsearchai-local` uses these values directly when .env.chartsearch is
# absent. Copy this file only when you need local overrides. Never commit secrets.

# OpenMRS data and UI
OMRS_DB_NAME=openmrs
OPENMRS_REFAPP_TAG=nightly-chartsearch
HARNESS_PROXY_HTTP_PORT=8088
HARNESS_PROXY_HTTPS_PORT=8443

# One product endpoint: ChartSearchAI -> med-agent-hub -> llama.cpp.
# ChartSearchAI does not discover or call the raw model server.
CHARTSEARCH_HUB_ENDPOINT_URL=http://med-agent-hub:8080/v1/chat/completions
CHARTSEARCH_HUB_PROFILE_ID=single-e4b-checked
CHARTSEARCH_HUB_API_KEY=
MED_AGENT_HUB_PORT=18081
MED_AGENT_LLM_BASE_URL=http://host.docker.internal:8077

# llama.cpp router. The host-native binary is used on macOS so Metal remains
# available. Model files default to ~/.cache/llama-router-models; override with
# an existing directory containing the filenames in scripts/llama-router.ini.
LLAMA_MODEL_DIR=
LLAMA_ROUTER_MODELS_MAX=1

# Local entrypoint behavior: auto rebuilds stale/missing Java, Querystore, and
# ESM artifacts; answer warmup exercises the staged E4B path through answer_done.
CHARTSEARCH_LOCAL_BUILD=auto
CHARTSEARCH_LOCAL_WARM=answer

# Local OpenMRS bootstrap credentials are used only to create/update the
# dedicated patient-reader role and service user through the OpenMRS REST API.
# The generated service password is stored mode 0600 under artifacts/.
CHARTSEARCH_ADMIN_USER=admin
CHARTSEARCH_ADMIN_PASSWORD=Admin123

# Optional externally-managed least-privileged patient source credentials. Set
# all three to skip local provisioning. The role needs only `Get Patients`.
QUERYSTORE_BASE_URL=
# Optional host-reachable URL used only by local startup verification when the
# hub-facing QUERYSTORE_BASE_URL uses a container-only hostname.
QUERYSTORE_VERIFY_BASE_URL=
QUERYSTORE_USERNAME=
QUERYSTORE_PASSWORD=
