# med-agent-hub ("Med Agent Team") configuration for the harness
#
# Copy to .env.med-agent-hub and edit:
#   cp .env.med-agent-hub.example .env.med-agent-hub
#   $EDITOR .env.med-agent-hub
#
# Source before running compose / make (the compose service reads these via
# ${VAR:-default} substitution):
#   set -a; . .env.med-agent-hub; set +a
#
# .env.med-agent-hub is .gitignored. All vars are OPTIONAL. The canonical local
# product path uses the llama.cpp router configured by `make chartsearchai-local`.

# --- LLM endpoint the team calls ---
# The hub talks to an OpenAI-compatible model router. Local product defaults use
# the host-native llama.cpp router on port 8077.
MED_AGENT_LLM_BASE_URL=http://host.docker.internal:8077

# --- Team models (swappable per role) ---
# Orchestrator + synthesizer (one model, dual role). Use the official google/
# gemma-4 build — some community GGUFs (unsloth, e2b) ship a broken jinja tool
# template that 400s on tool-calling. llama-3.1-8b is a working fallback.
MED_AGENT_ORCHESTRATOR_MODEL=google/gemma-4-e4b
# Medical expert tool (free-text clinical reasoning).
MED_AGENT_MED_MODEL=medgemma-1.5-4b-it

# --- Decoding ---
MED_AGENT_TEMPERATURE=0.0

# SSE comments let the OpenMRS relay detect browser aborts while a model stage is
# still running. Keep this short enough that trailing In-Depth can be preempted.
HUB_SSE_HEARTBEAT_SECONDS=0.5

# IANA timezone used to resolve the product profile's wall-clock "today". Set this to the
# deployment/OpenMRS timezone; the canonical local launcher derives it from the host automatically.
HUB_TIMEZONE=UTC
