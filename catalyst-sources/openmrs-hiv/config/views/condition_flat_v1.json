{
  "resourceType": "http://hl7.org/fhir/uv/sql-on-fhir/StructureDefinition/ViewDefinition",
  "name": "condition_flat_v1",
  "status": "active",
  "resource": "Condition",
  "fhirVersion": [
    "4.0"
  ],
  "select": [
    {
      "column": [
        {
          "path": "getResourceKey()",
          "name": "id"
        },
        {
          "path": "subject.getReferenceKey(Patient)",
          "name": "patient_id"
        },
        {
          "path": "clinicalStatus.coding.first().code",
          "name": "clinical_status"
        },
        {
          "path": "code.coding.where(system = 'https://cielterminology.org').first().system",
          "name": "condition_system"
        },
        {
          "path": "code.coding.where(system = 'https://cielterminology.org').first().code",
          "name": "condition_code"
        },
        {
          "path": "code.coding.first().display",
          "name": "condition_name"
        },
        {
          "path": "onset.ofType(dateTime)",
          "name": "onset_at",
          "type": "dateTime"
        },
        {
          "path": "recordedDate",
          "name": "recorded_at",
          "type": "dateTime"
        }
      ]
    }
  ]
}
